# Single password for app access (set on Vercel + .env.local for dev)
APP_PASSWORD=

# GitHub repo for upload feature: "owner/repo"
GITHUB_REPO=spritwind/Prefect_Prompt

# GitHub Personal Access Token with `contents:write` scope on GITHUB_REPO.
# Required for the in-app /upload feature to commit new prompts.
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_PAT=
